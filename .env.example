# Google Cloud Console > OAuth 2.0 Client IDs (Desktop app) 에서 발급
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# blog_automation/get_refresh_token.py 실행 후 출력되는 값
GOOGLE_REFRESH_TOKEN=

# Blogger 관리 화면 URL 에서 확인 가능한 블로그 ID
BLOGGER_BLOG_ID=

# Meta 개발자 앱(Threads API 제품 추가) 에서 발급한 장기 액세스 토큰
THREADS_ACCESS_TOKEN=

# blog_automation/get_threads_user_id.py 실행 후 출력되는 값
THREADS_USER_ID=

# 카카오 개발자 앱 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# blog_automation/get_kakao_token.py 실행 후 출력되는 값
KAKAO_REFRESH_TOKEN=
